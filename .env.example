# Copy to .env and fill in only what you use. Never commit .env.
# JULI prefers the OS keychain (Settings > API Keys); these are the fallback
# for machines without one. Variable name: <PROVIDER>_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional server settings
# JULI_DATA_DIR=./data
# JULI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JULI_DEBUG=1
